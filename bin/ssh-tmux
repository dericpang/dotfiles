#!/bin/bash
SLEEP_TIME=1 # The delay in seconds before attempting to reconnect.
ALIVE_INTERVAL=10 # How long to keep the SSH session alive.
HOSTNAME="$1" # The hostname is passed as the first argument.
TMUX_SESSION="$2" # The tmux session name is passed as the second argument.
SSH_OPTS="-oCompression=yes -oCheckHostIP=no -oServerAliveInterval=$ALIVE_INTERVAL"

# Reattaching to an existing tmux session does not source shell startup files.
# Refresh the remote socket first so existing panes follow the new connection.
TMUX_CMD='if forwarded_agent_socket=$("$HOME/bin/ssh-agent-socket"); then
  export SSH_AUTH_SOCK="$forwarded_agent_socket"
else
  unset SSH_AUTH_SOCK
fi
exec tmux new-session -A -s'

if [ -z "$HOSTNAME" ] ; then
  echo "Usage: $0 <HOSTNAME> [TMUX_SESSION]"
  exit 1
fi

if [ -z "$TMUX_SESSION"  ] ; then
  echo "No tmux session was specified, defaulting to \"main\"."
  TMUX_SESSION="main"
fi

# Ctrl-C while waiting to reconnect should quit, not loop around again.
trap 'exit 130' INT

# Attempt to keep reconnect upon failure.
while true; do
  # $SSH_OPTS is intentionally unquoted so it splits into separate arguments.
  ssh -t "$HOSTNAME" $SSH_OPTS "$TMUX_CMD" "$TMUX_SESSION"
  RC=$?

  # Only a transport failure (255) means the connection actually dropped.
  # Anything else -- a clean detach, or tmux itself refusing to start -- is
  # terminal, so don't spin on it.
  [ $RC -eq 255 ] || break

  echo "SSH connection lost, reconnecting in $SLEEP_TIME seconds..."
  sleep $SLEEP_TIME
done

exit $RC
